<?xml version="1.0" encoding="utf-8"?>
<!--
    The base language. **Every user-visible string lives here**, never as a literal in Kotlin — that
    is what makes the app translatable at all, and `TranslationTest` is what keeps it true.

    Two rules with teeth:

    - A string with a format argument must carry the **same arguments in every locale**, and
      positional (`%1$s`) rather than bare (`%s`) whenever there is more than one, so a translator
      can reorder them. `TranslationTest` checks this continuously.
    - A count-dependent string is a `<plurals>`, never string concatenation. The categories that
      apply differ by language — Polish has `one`, `few`, `many`, `other` where English has two —
      and CLDR decides which, not the translator.

    `translatable="false"` marks a string that is deliberately identical everywhere: the app's own
    name, and the language endonyms in the switcher, which are named in their own language on
    purpose so someone lost in a language they cannot read can find their way back.
-->
<resources>
    <string name="app_name" translatable="false">Gloam</string>

    <!-- Navigation -->
    <string name="tab_dim">Dim</string>
    <string name="tab_settings">Settings</string>

    <!-- Common actions -->
    <string name="action_back">Back</string>

    <!-- The dim screen. "Dim level" rather than "brightness" throughout, per CONTEXT.md: the
         backlight is Android's value and this one runs the other way. -->
    <string name="dim_title">Dim</string>
    <string name="dim_level_label">Dim level</string>
    <!-- The hero value is drawn as two pieces at two type sizes, so the number and the sign are
         two resources rather than one formatted string. Both are translatable="false": one is a
         bare integer placeholder and the other is a symbol. A locale that writes the sign before
         the number would need the composable changed, not this file. -->
    <string name="dim_level_number" translatable="false">%1$d</string>
    <string name="dim_level_percent" translatable="false">%</string>
    <!-- Reads on from the value above it: "40% / of the light covered." Two sentences: what the
         number means, then what to do with the column beside it. -->
    <string name="dim_level_caption">of the light covered. Pull the column down for less light.</string>
    <!-- On the part of the column the shade never reaches: the dimmest the phone's own backlight
         goes. "Floor" is CONTEXT.md's word — never "minimum brightness", which reads as ours. -->
    <string name="dim_column_floor">FLOOR</string>
    <string name="dim_start">Start dimming</string>
    <string name="dim_stop">Stop dimming</string>
    <string name="dim_permission_title">Gloam needs permission to draw over other apps</string>
    <string name="dim_permission_body">The shade is a layer on top of whatever is on screen, so Android asks you to allow it explicitly. Gloam reads nothing about the apps underneath. When you start dimming it will also ask to show a notification — that notification is how you stop Gloam from anywhere.</string>
    <string name="dim_permission_grant">Open settings</string>

    <!-- The escape-hatch warning. It makes a safety claim — that there is a Stop button outside the
         app — so it names the consequence rather than the permission. -->
    <string name="dim_notification_warning_title">No Stop button outside Gloam</string>
    <string name="dim_notification_warning_body">Gloam is allowed to dim your screen but not to show a notification, so the only way to stop it is this screen.</string>
    <string name="dim_notification_warning_channel_body">Gloam\'s notification is switched off, so the only way to stop dimming is this screen.</string>
    <string name="dim_notification_warning_ask">Allow notifications</string>
    <string name="dim_notification_warning_settings">Open notification settings</string>

    <!-- The backlight toggle. The hint says the inert brightness slider out loud, because the
         symptom recurs and a user who meets it with no explanation reports that Gloam broke their
         phone. The unavailable line replaces the promise on a device that cannot keep it. -->
    <string name="dim_backlight_label">Also lower the screen brightness</string>
    <string name="dim_backlight_hint">Your brightness slider is paused while Gloam dims.</string>
    <string name="dim_backlight_unavailable">This phone does not report its brightness in a way Gloam can use, so Gloam dims by drawing over the screen only.</string>

    <!-- Auto-off (CONTEXT.md). It cannot be switched "off" — "off" is reserved for the shade not
         being drawn, so the choice that disables it is Never. The hint says what the feature buys
         rather than what it does: the failure being designed out is a phone dimmed at midnight and
         still dark at breakfast. "Turns off at 23:40" is a clock time formatted by the platform,
         never a countdown built out of words. -->
    <string name="dim_auto_off_label">Turn off on its own</string>
    <string name="dim_auto_off_hint">Gloam takes the shade down by itself after this long, so a screen you dimmed and forgot about is not still dark tomorrow.</string>
    <!-- %1$s is a time of day, formatted for the phone's own locale and 12/24-hour setting. -->
    <string name="dim_auto_off_at">Turns off at %1$s</string>

    <!-- The auto-off chips, on every surface that has them (docs/phase-3.md §2). They keep their
         compact_ names because the compact controls are where the short wording was decided: R5
         read five chips saying "After 30 minutes" wrapping in a floating window, and the redesign
         put the same five into a card on the full screen rather than a second, longer set. The duration carries no "+" because
         the same chip means two things — while the shade is up, tapping one re-dates the deadline
         from now ("two more hours"); while it is down, it sets what the next shade will get. The
         section header above them is dim_auto_off_label, which says which of the two is happening. -->
    <string name="compact_auto_off_never">Never</string>
    <string name="compact_auto_off_30m">30 min</string>
    <string name="compact_auto_off_1h">1 hour</string>
    <string name="compact_auto_off_2h">2 hours</string>
    <string name="compact_auto_off_4h">4 hours</string>

    <!-- The warmth slider. "Warmth" per CONTEXT.md: not "night mode" — that is the app's own dark
         theme — and not any wording about filtering or cutting blue light, which an overlay cannot
         do. It adds a tint, somewhere between amber and deep red, over an already-dark screen. -->
    <string name="dim_warmth_label">Warmth</string>
    <!-- The bar under Warmth: which tint, from amber at one end to deep red at the other. "Colour"
         in the sense of hue only. How strong the tint is belongs to the Warmth bar, and this one has
         no number beside it. Short: it sits in a column beside a slider on a phone held upright. -->
    <string name="dim_warmth_color_label">Colour</string>

    <!-- The presets: three chips under Warmth, each setting the dim level, warmth and colour at once
         and starting the shade. Labels are the situation, not the setting — short, they sit side by
         side in one row. The line under the chips is the hint of whichever is lit, and presets_hint
         when none is (the user has moved a control off every preset). Describe the look only:
         nothing about sleep, eyes or blue light (translator brief §2.2). -->
    <string name="preset_reading">Reading</string>
    <string name="preset_reading_hint">Dark, with almost no tint, so text keeps its contrast.</string>
    <string name="preset_evening">Evening</string>
    <string name="preset_evening_hint">Lightly dimmed and strongly warm, for the hours before the lights go off.</string>
    <string name="preset_in_bed">In bed</string>
    <string name="preset_in_bed_hint">Nearly dark and deep red, for a room with the lights off.</string>
    <string name="presets_hint">Tap one to start dimming from it, then adjust anything above.</string>

    <!-- The compact controls (docs/phase-3.md §2, §10). The floating window shows the same sliders
         and nothing else, so this is its one way to the rest of the app — without it the dialog is a
         dead end with no Settings behind it. "Open Gloam" and not "Open the app": the user knows the
         name, and it is the word on the icon they would otherwise have to go and find. -->
    <string name="controls_open_app">Open Gloam</string>
    <string name="panel_close">Close controls</string>

    <!-- Settings -->
    <string name="settings_appearance">Appearance</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <!-- The launcher route (docs/phase-3.md §2, §10). "The small controls" rather than "compact
         mode": there is no mode, and the notification and the tile reach the same window whatever
         this is set to. "The icon" rather than "the launcher", which is a developer's word. The
         hint says what the preference does *not* move, because it moves one route of three. -->
    <string name="settings_controls">Controls</string>
    <string name="settings_launcher_compact">Open the small controls from the icon</string>
    <string name="settings_launcher_compact_hint">Tapping Gloam opens just the sliders instead of the whole app. The notification always opens the small controls.</string>
    <string name="settings_controls_bubble">Leave a bubble when the controls close</string>
    <string name="settings_controls_bubble_hint">While dimming, tapping outside the controls shrinks them to a small bubble. Tap it to bring them back, or drag it onto the ✕ to remove it.</string>
    <string name="bubble_open">Open the controls</string>
    <string name="bubble_prompt_title">Keep the bubble?</string>
    <string name="bubble_prompt_body">Turn it off and the controls simply close. You can turn it back on in Settings.</string>
    <string name="bubble_prompt_turn_off">Turn off</string>
    <string name="bubble_prompt_keep">Keep it</string>

    <!--
      The Quick Settings tile. The body says what the tile is and what it does not depend on, and
      deliberately stops there. It is tempting to explain that on some phones the notification's
      Stop action needs a two-finger pull to appear — that was measured, but on one ROM, and §2.3 of
      the translator brief says the app does not state what it cannot know. If the testers show it
      generalises, this string gains a sentence.
    -->
    <string name="settings_tile">Quick Settings tile</string>
    <string name="settings_tile_body">A tile that turns the shade on and off from anywhere, without opening Gloam. It does not need notifications to be allowed, so it still works when the notification does not.</string>
    <string name="settings_tile_add">Add the tile</string>
    <string name="settings_tile_added">The tile is in Quick Settings.</string>
    <string name="settings_tile_unavailable">This phone did not offer to add it. You can still add it yourself by editing Quick Settings.</string>

    <!-- The lock screen (docs/night-reading-research.md §4). The keyguard hides every overlay
         window, and the shade's backlight override goes with it, so waking the phone at night is the
         brightest moment of the session and nothing Gloam draws can change that. The first sentence
         says whose behaviour it is, so it does not read as a Gloam defect; the second is the only
         help there is. "Brightness", not "backlight": it is the user's own setting, in Android's
         word. Glare, never sleep - no health claims. -->
    <string name="settings_lock_screen">Lock screen</string>
    <string name="settings_lock_screen_body">Gloam cannot dim the lock screen: Android shows it at your phone\'s own brightness. Keep that brightness low at night, so the lock screen is not the brightest thing in a dark room.</string>

    <!-- Flicker (docs/night-reading-research.md §2). Filmed on the development phone: below
         somewhere between 126 and 64 nits the panel dims by PWM, and the backlight floor is far inside
         that. The only lever an app has is to leave the backlight alone, which costs darkness, so the
         body says it as a trade-off rather than a fix. The phone's own anti-flicker setting is
         mentioned, never promised: it is hidden on the development phone, so how it behaves with a
         lowered backlight is untested. No numbers, because the switch point differs between panels.
         Tiring, not eye strain - no health claims. %1$s is dim_backlight_label, quoted as the toggle's
         name so it cannot drift from it. -->
    <string name="settings_flicker">Flicker</string>
    <string name="settings_flicker_body">At low brightness, many screens flicker too fast to see, and some people find that tiring. If you do, turn off “%1$s” and keep your phone\'s own brightness higher. The screen won\'t get as dark, but it won\'t flicker. Some phones also have an anti-flicker or DC dimming option in their display settings.</string>

    <string name="settings_language">Language</string>
    <string name="settings_language_system">System</string>
    <!-- Endonyms, and `translatable="false"` for the reason translator-brief.md §4 gives: each
         language is named in its own language in *every* locale, so someone who has landed in a
         language they cannot read finds their way out by a name they recognise. They live only in
         this file — a locale that repeated them would be an orphan, and resource fallback already
         serves the base value to every locale. -->
    <string name="settings_language_english" translatable="false">English</string>
    <string name="settings_language_polish" translatable="false">Polski</string>
    <string name="settings_language_czech" translatable="false">Čeština</string>
    <string name="settings_language_german" translatable="false">Deutsch</string>
    <string name="settings_language_spanish" translatable="false">Español</string>
    <string name="settings_language_french" translatable="false">Français</string>
    <string name="settings_language_italian" translatable="false">Italiano</string>
    <string name="settings_language_portuguese_br" translatable="false">Português (Brasil)</string>
    <string name="settings_language_ukrainian" translatable="false">Українська</string>
    <!-- The report route, and it is the mechanism that replaces a native read-through rather than a
         courtesy row (ADR-0014). It sits here, under the picker, because this is where someone is
         standing the moment a word reads wrong — a channel nobody can find is the same as no
         channel. The hint says the language travels with the mail, so nobody has to explain which
         one they are reading. -->
    <string name="settings_language_report">Something read wrong?</string>
    <string name="settings_language_report_hint">Tell me if a word looks wrong in your language. Opens your email app, with the language you are reading already filled in.</string>
    <!-- Reboot restore, and the hand-off to Xiaomi's autostart screen. Shown only where that
         screen exists, which is what lets the second sentence say "this phone" — nobody whose
         phone has no such setting ever reads it. It promises nothing about the outcome: the app
         cannot read that setting back, and the honest thing is to name where to look rather than
         to report a state it is guessing at. -->
    <string name="settings_restart">After a restart</string>
    <string name="settings_restart_body">Gloam puts the shade back when your phone restarts. This phone only lets an app run at startup if autostart is switched on for it, and Gloam has no way to check whether it is — so if the shade does not come back, this is the setting to look at.</string>
    <string name="settings_restart_open">Open autostart settings</string>

    <string name="settings_about">About</string>
    <string name="settings_support">Help and feedback</string>
    <string name="settings_licences">Open-source licences</string>

    <!-- Help and feedback. Both rows leave Gloam for the user's own mail app, so both hints say so
         before the tap rather than after it. The two subjects are `translatable="false"` because
         they carry a filter tag the developer sorts on and the user never reads — the prompt beside
         each one is the sentence they actually see, and a Polish bug report under `Gloam #bug` is
         the correct outcome of an app with a Polish locale. The prompts are second-person-free:
         gender is not something the app knows (translator-brief.md 6.2). -->
    <string name="support_title">Help and feedback</string>
    <string name="support_report">Report a problem</string>
    <string name="support_report_hint">Opens your email app with what Gloam knows about your phone already filled in.</string>
    <string name="support_feature">Suggest a feature</string>
    <string name="support_feature_hint">Every feature in Gloam is free and always will be, so the only question is whether it belongs.</string>
    <string name="support_subject_bug" translatable="false">Gloam #bug</string>
    <string name="support_subject_feature" translatable="false">Gloam #feature</string>
    <!-- A tag of its own rather than #bug, because seven languages ship without a native
         read-through (ADR-0014) and translation reports are the one kind of mail this release
         expects in quantity. Sorting them apart is what lets a fluency fix be batched into one
         string release instead of triaged one report at a time. -->
    <string name="support_subject_language" translatable="false">Gloam #language</string>
    <string name="support_body_bug">What happened, and what you expected instead:</string>
    <string name="support_body_feature">What would you like Gloam to do?</string>
    <!-- Asks for the screen as well as the word: a resource id means nothing to the sender, and
         where they saw it is what turns a report into an edit. -->
    <string name="support_body_language">Which word read wrong, and on which screen?</string>
    <string name="support_no_mail_app">No email app on this phone to open.</string>
    <string name="support_rate">Rate Gloam on Google Play</string>
    <string name="support_rate_hint">Opens Gloam\'s page on Google Play. Rating is optional and unlocks nothing, because nothing in Gloam is locked.</string>
    <string name="support_no_play">No Google Play or web browser on this phone to open.</string>

    <!-- Licences -->
    <string name="licence_text_missing">The text of this licence is not bundled with the app.</string>

    <!-- The schedule (docs/phase-4.md §11). "Schedule", not "timer" or "alarm": CONTEXT.md reserves
         both — auto-off is not a timer because the schedule sets deadlines too, and nothing here is
         an alarm because nothing rings and the app claims no exact-alarm permission. No health
         claims anywhere near this copy — no *eye strain*, no *sleep*, no *blue light* — because App
         content was answered health-No and this is the feature most likely to reach for the word
         "night". The two times are never built by hand: DateFormat.getTimeFormat does it, so 12- or
         24-hour follows the phone and the locale for free. -->
    <string name="schedule_title">Schedule</string>
    <string name="schedule_enable">Dim on a schedule</string>
    <string name="schedule_enable_hint">Gloam puts the shade up and takes it down on its own, every night.</string>
    <!-- The two kinds of schedule (ADR-0013). "Sunset to sunrise", never "twilight" or "dusk":
         sunset is the moment weather apps print, and CONTEXT.md keeps the darker one after it out of
         the copy. -->
    <string name="schedule_kind_fixed">Fixed times</string>
    <string name="schedule_kind_sun">Sunset to sunrise</string>
    <!-- %1$s is tonight's sunset and %2$s the sunrise after it, as times of day in the phone's own
         format. After midnight it describes the night already under way, which is still "tonight". -->
    <string name="schedule_sun_tonight">Tonight: sunset %1$s, sunrise %2$s</string>
    <!-- Polar nights, when the sun does not set (midnight sun) or does not rise (polar night). The
         schedule falls back to the fixed times for that night rather than doing nothing. -->
    <string name="schedule_sun_fallback_tonight">The sun does not set or rise here tonight, so the times below are used.</string>
    <string name="schedule_sun_fallback_note">On nights the sun does not set or rise here, the shade uses these times.</string>
    <!-- Which location sunset is worked out for, which the screen always says (ADR-0013 §6).
         "Location", never "position" or "GPS" (CONTEXT.md): Gloam asks only for the approximate one,
         and says so, because that is the word Android's own permission dialog uses. -->
    <string name="schedule_location_estimated">Sunset is estimated from your time zone.</string>
    <string name="schedule_location_lent">Sunset uses this phone\'s approximate location.</string>
    <string name="schedule_location_none">Your time zone gives no location, so the times below are used every night.</string>
    <string name="schedule_location_ask">Use this phone\'s location</string>
    <string name="schedule_location_ask_hint">For a more accurate sunset. Gloam asks for approximate location only, and keeps it on this phone.</string>
    <!-- Replaces schedule_location_ask once Android has stopped showing the permission dialog, which
         it does after two refusals. The only way to allow it then is the app's page in Settings. -->
    <string name="schedule_location_settings">Allow location in settings</string>
    <string name="schedule_on_at">Turns on</string>
    <string name="schedule_off_at">Turns off</string>
    <!-- Shown only when the pair crosses midnight. It is one derived fact and it is the single most
         common way a person mis-reads two times. -->
    <string name="schedule_overnight">Overnight — the shade comes down the next morning.</string>
    <!-- The degenerate window is refused at the picker rather than stored and explained afterwards:
         on at 22:00 and off at 22:00 read as a full day is a shade that never comes down. -->
    <string name="schedule_same_time">Pick two different times. A window that starts and ends at the same moment never opens.</string>
    <!-- A short window is warned about and *not* refused, which is the opposite treatment and the
         same reasoning: an inexact alarm arrives at the far end of a batching window, so a window of
         a few minutes can be missed entirely — and a schedule that does nothing is the visible,
         harmless failure this feature prefers. -->
    <string name="schedule_short_window">This window is very short. Android may start Gloam a few minutes late, so a window this short can be missed.</string>

    <!-- The battery-optimisation banner, shown only while the schedule is on and the exemption is
         missing. **One of three drafts, and R1 picked this one** (docs/phase-4.md §11): without the
         exemption the alarm still fires and startForegroundService is refused, so the shade does not
         come up at the time the user picked and the reconcile raises it the next time they open
         Gloam inside the window. The key keeps its `_delegated` suffix as the record of which draft
         shipped. "Android", not "this phone": the refusal is the platform's
         (ForegroundServiceStartNotAllowedException) and the sentence would be wrong on a Pixel if it
         blamed the vendor. What the vendor owns is autostart, which is schedule_rom_note below. -->
    <string name="schedule_battery_title">Battery optimisation is on for Gloam</string>
    <string name="schedule_battery_body_delegated">Android will not let Gloam start itself at the time you picked. The shade still comes up when you next open Gloam inside the window. Turn battery optimisation off for Gloam to have it start on its own.</string>
    <string name="schedule_battery_action">Battery settings</string>
    <!-- Shown only where an autostart screen exists. It points at the row in Settings rather than
         growing a second hand-off for one grant, and it promises nothing about the outcome — the app
         cannot read that setting back (ADR-0003). -->
    <string name="schedule_rom_note">This phone can also stop apps from starting in the background. If the shade does not start on its own, it will still come up when you open Gloam — and After a restart in Settings is where you can change that.</string>

    <!-- The summary row on the dim screen, and the compact controls' read-only section. It states
         the window rather than the setting, so a user who set a schedule three weeks ago and forgot
         finds out on the screen they already open. When the exemption is missing it says that
         instead: the person who forgot is by definition not opening the schedule screen, so the
         honest state has to live where they do go. -->
    <string name="dim_schedule_row">Schedule</string>
    <!-- %1$s and %2$s are times of day, formatted for the phone's own locale and 12/24-hour setting. -->
    <string name="dim_schedule_window">%1$s to %2$s</string>
    <string name="dim_schedule_off">Off</string>
    <string name="dim_schedule_at_risk">Schedule — may not start on its own</string>

    <!-- Notification channels. The convention `channel_<id>_name` / `channel_<id>_description` is
         asserted by ReminderChannelsTest, so a new channel cannot ship with no name. -->
    <string name="channel_shade_name">Dimming</string>
    <string name="channel_shade_description">Shown while the screen is dimmed, so the shade can be turned off from anywhere.</string>
    <string name="shade_notification_title">Screen dimmed</string>
    <string name="shade_notification_stop">Stop</string>
    <!-- The deadline, on the notification rather than in the app, because the moment it moves
         *outward* — the schedule taking over an episode the hand started — the user is in a reading
         app and not on our screen (docs/phase-4.md §3). setSubText, so it does not displace the
         backlight sentence below, and absent rather than empty when there is no deadline.
         %1$s is a time of day, formatted by the platform. -->
    <string name="shade_notification_until">Until %1$s</string>
    <!-- Carried only while the backlight override is actually live. It is the one line of copy in
         this app that gets read on a screen at the backlight floor, because the notification is drawn above
         the shade and dim_backlight_hint is in the app underneath it - so it is short, and it names
         the symptom before the cause. -->
    <string name="shade_notification_text_backlight">Your brightness slider is paused while Gloam is dimming</string>
</resources>
