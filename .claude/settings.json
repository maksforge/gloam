{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$CLAUDE_PROJECT_DIR/scripts/push-notes-hook.py\"; [ -f \"$hook\" ] || exit 0; exec python3 \"$hook\"",
            "timeout": 30,
            "statusMessage": "Checking the next release has its notes"
          }
        ]
      }
    ]
  }
}
